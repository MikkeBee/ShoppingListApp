## 4. State Management Implementation

### 4.1 TypeScript Definitions
```typescript
// types/shopping.ts
export interface ShoppingItem {
  id: string;
  name: string;
  quantity: string;
  unit?: string;
  category: ItemCategory;
  isCompleted: boolean;
  createdAt: Date;
  updatedAt: Date;
}

export interface ShoppingList {
  id: string;
  name: string;
  items: ShoppingItem[];
  createdAt: Date;
  updatedAt: Date;
}

export interface AppState {
  lists: ShoppingList[];
  activeListId: string | null;
  ui: UIState;
}

export interface UIState {
  isLoading: boolean;
  editingItemId: string | null;
  selectedItems: string[];
  showDeletedMessage: boolean;
  lastDeletedItems: ShoppingItem[];
  isMobile: boolean;
}

export enum ItemCategory {
  MEAT = 'meat',
  DAIRY = 'dairy',
  FISH_SEAFOOD = 'fish-seafood',
  FRUITS = 'fruits',
  VEGETABLES = 'vegetables',
  GRAINS_BREAD = 'grains-bread',
  PANTRY = 'pantry',
  FROZEN = 'frozen',
  BEVERAGES = 'beverages',
  SNACKS = 'snacks',
  HOUSEHOLD = 'household',
  PERSONAL_CARE = 'personal-care',
  OTHER = 'other'
}

export type AppAction =
  | { type: 'ADD_LIST'; payload: { name: string } }
  | { type: 'DELETE_LIST'; payload: { id: string } }
  | { type: 'SET_ACTIVE_LIST'; payload: { id: string } }
  | { type: 'ADD_ITEM'; payload: { listId: string; item: Omit<ShoppingItem, 'id' | 'createdAt' | 'updatedAt'> } }
  | { type: 'UPDATE_ITEM'; payload: { listId: string; itemId: string; updates: Partial<ShoppingItem> } }
  | { type: 'DELETE_ITEM'; payload: { listId: string; itemId: string } }
  | { type: 'TOGGLE_ITEM_COMPLETE'; payload: { listId: string; itemId: string } }
  | { type: 'SET_EDITING_ITEM'; payload: { itemId: string | null } }
  | { type: 'SET_MOBILE'; payload: { isMobile: boolean } };
```

### 4.2 Shopping Context
```typescript
// contexts/ShoppingContext.tsx
const ShoppingContext = createContext<{
  state: AppState;
  dispatch: React.Dispatch<AppAction>;
  actions: {
    addList: (name: string) => void;
    deleteList: (id: string) => void;
    setActiveList: (id: string) => void;
    addItem: (listId: string, item: Omit<ShoppingItem, 'id' | 'createdAt' | 'updatedAt'>) => void;
    updateItem: (listId: string, itemId: string, updates: Partial<ShoppingItem>) => void;
    deleteItem: (listId: string, itemId: string) => void;
    toggleItemComplete: (listId: string, itemId: string) => void;
    bulkDeleteItems: (listId: string, itemIds: string[]) => void;
    startEditing: (itemId: string) => void;
    stopEditing: () => void;
  };
} | null>(null);
```

## 5. Mobile-First Implementation Strategy

### 5.1 Touch Interactions
```scss
// styles/mixins.scss
@mixin touch-target {
  min-height: 44px;
  min-width: 44px;
}

@mixin swipe-gesture {
  touch-action: pan-y;
  user-select: none;
  -webkit-user-select: none;
}

@mixin mobile-scroll {
  -webkit-overflow-scrolling: touch;
  overflow-y: auto;
}
```

### 5.2 Mobile Navigation Pattern
```scss
// components/shopping/ItemsList/ItemsList.module.scss
.items-container {
  // Mobile: Full screen with padding
  padding: var(--space-4);
  
  @include respond-to(md) {
    // Tablet: Sidebar or split view
    padding: var(--space-6);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }
  
  @include respond-to(lg) {
    // Desktop: Three column layout
    grid-template-columns: 300px 1fr 1fr;
  }
}

.mobile-actions {
  position: fixed;
  bottom: var(--space-4);
  right: var(--space-4);
  z-index: 50;
  
  @include respond-to(md) {
    display: none;
  }
}

.fab {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background-color: var(--color-add);
  color: white;
  border: none;
  box-shadow: var(--shadow-lg);
  cursor: pointer;
  transition: all 0.3s ease-in-out;
  
  &:hover {
    transform: scale(1.1);
  }
  
  &:active {
    transform: scale(0.95);
  }
}
```

### 5.3 Progressive Enhancement
```typescript
// hooks/useResponsive.ts
export const useResponsive = () => {
  const [breakpoint, setBreakpoint] = useState<'mobile' | 'tablet' | 'desktop'>('mobile');
  
  useEffect(() => {
    const updateBreakpoint = () => {
      const width = window.innerWidth;
      if (width < 768) {
        setBreakpoint('mobile');
      } else if (width < 1024) {
        setBreakpoint('tablet');
      } else {
        setBreakpoint('desktop');
      }
    };
    
    updateBreakpoint();
    window.addEventListener('resize', updateBreakpoint);
    return () => window.removeEventListener('resize', updateBreakpoint);
  }, []);
  
  return {
    isMobile: breakpoint === 'mobile',
    isTablet: breakpoint === 'tablet',
    isDesktop: breakpoint === 'desktop',
    breakpoint
  };
};
```

## 6. Vercel Deployment Configuration

### 6.1 Vercel Configuration
```json
// vercel.json
{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "functions": {
    "app/api/**/*.ts": {
      "runtime": "nodejs18.x"
    }
  },
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
```

### 6.2 Environment Variables
```bash
# .env.local
NEXT_PUBLIC_APP_NAME=Shopping List
NEXT_PUBLIC_VERSION=1.0.0
NEXT_PUBLIC_ENVIRONMENT=production
```

### 6.3 Build Optimization
```typescript
// next.config.ts
import type { NextConfig } from 'next';

const nextConfig: NextConfig = {
  experimental: {
    optimizeCss: true,
    scrollRestoration: true,
  },
  compress: true,
  poweredByHeader: false,
  reactStrictMode: true,
  swcMinify: true,
  images: {
    formats: ['image/webp', 'image/avif'],
    minimumCacheTTL: 60,
  },
  sassOptions: {
    includePaths: ['./styles'],
    prependData: `
      @import "variables";
      @import "mixins";
      @import "breakpoints";
    `,
  },
};

export default nextConfig;
```

